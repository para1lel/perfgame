# 复制到 /etc/perfgame/env 并填写。不要提交真实值。

PERFGAME_DB=sqlite:////opt/perfgame/data/perfgame.db
PERFGAME_DATA_DIR=/opt/perfgame/data
PERFGAME_HW_PROFILE=/opt/perfgame/hw/h100-pcie.yaml

# 单机单 worker 可用 memory://，多 worker 必须是 redis
PERFGAME_QUEUE=memory://

# GitHub OAuth App（Settings → Developer settings → OAuth Apps）
PERFGAME_GITHUB_CLIENT_ID=
PERFGAME_GITHUB_CLIENT_SECRET=
PERFGAME_SESSION_SECRET=

PERFGAME_PUBLIC_URL=http://localhost:8000
PERFGAME_ALLOWED_ORIGINS=http://localhost:5173
